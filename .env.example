# Gere valores reais com scripts/init-deploy.sh. Nunca versionar .env.
DB_PASSWORD=
SAFEELO_ENCRYPTION_KEY=
APP_BASE_URL=http://localhost:8080
# Necessário apenas para produção com HTTPS e Caddy:
DOMAIN=
# Opcional. Sem SMTP, avisos funcionam apenas dentro do app; recuperação fica indisponível.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=
